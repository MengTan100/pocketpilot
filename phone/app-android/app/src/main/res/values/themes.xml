<resources>
    <!--
      与 DSH 官方图标同一套色：深青为主，浅灰为底。

      ⚠️ Android 15（targetSdk 35）起系统强制 edge-to-edge：
      android:statusBarColor 会被忽略，状态栏变透明、直接露出页面内容。
      而本页是浅色，若状态栏图标仍是浅色，就会出现"时间电量看不见"。
      正确做法是改用 windowLightStatusBar（深色图标）+ 透明系统栏背景，
      并按 WindowInsets 给顶部留出安全区（见 MainActivity.applySystemBarInsets）。
    -->
    <style name="Theme.DshBridge" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#203030</item>
        <item name="colorPrimaryDark">#162222</item>
        <item name="colorAccent">#2563EB</item>

        <!-- Android 15+ edge-to-edge：透明系统栏 + 深色图标 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>

        <item name="android:windowBackground">#FFFFFF</item>
    </style>
</resources>
