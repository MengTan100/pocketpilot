#!/bin/sh
# ============================================================================
#  提交前自动跑"安全与隐私自检"（SECURITY.md 的可执行版）
# ============================================================================
#  为什么需要它：本项目曾把明文访问令牌、真实姓名、设备序列号、内网 IP、
#  整段对话的界面转储、近百张手机截图和 500MB 第三方二进制带进仓库。
#  这些都不是"写错了代码"，而是"提交时没人拦"。
#
#  启用（每个 clone 各做一次）：
#      git config core.hooksPath .githooks
#
#  临时跳过（**想清楚再用**）：git commit --no-verify
# ============================================================================

if ! command -v node >/dev/null 2>&1; then
  echo "⚠️  未找到 node，跳过安全自检"
  exit 0
fi

node tools/security-check.mjs
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ 安全自检未通过 —— 已阻止本次提交。"
  echo "   规则与处置办法见 SECURITY.md；确认无误可用 git commit --no-verify 跳过。"
  exit 1
fi
